generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaiementStatus {
  PENDING
  SUCCESS
  FAILED
}

enum OperationStatus {
  PENDING
  CLOSED
  REJECTED
}

enum TransactionType {
  DEBIT
  CREDIT
}

model User {
  id       String  @id @unique @default(uuid())
  name     String  @unique
  mail     String? @unique
  mobile   String  @unique
  password String

  isRoot              Boolean @default(false)
  isActive            Boolean
  isStaff             Boolean @default(false)
  mustRenewPassword   Boolean @default(true)
  allowedDeviceNumber Int     @default(1)

  roleId String?

  createdAt       DateTime? @default(now())
  updatedAt       DateTime? @updatedAt
  updatedByUserId String?
  createdByUserId String?
  isDeleted       Boolean?  @default(false)
  meta            Json      @default("{}")

  role Role? @relation("user-role", references: [id], fields: [roleId])

  userPrivileges UserPrivilege[] @relation("User-Privilege")
  userDevices    UserDevice[]

  organizationsCreated  Organization[]  @relation("OrganizationCreatedBy")
  organizationsUpdated  Organization[]  @relation("OrganizationupdatedBy")
  actionsCreated        Action[]        @relation("Action-CreatedBy")
  actionsUpdated        Action[]        @relation("Action-updatedBy")
  rolesCreated          Role[]          @relation("Role-CreatedBy")
  rolesUpdated          Role[]          @relation("Role-updatedBy")
  roleActionsCreated    RoleAction[]    @relation("RoleAction-createdBy")
  roleActionsUpdated    RoleAction[]    @relation("RoleAction-updatedBy")
  userPrivilegesCreated UserPrivilege[] @relation("UserPrivilege-createdBy")
  userPrivilegesUpdated UserPrivilege[] @relation("UserPrivilege-updatedBy")
  menusCreated          Menu[]          @relation("Menu-createdBy")
  menusUpdated          Menu[]          @relation("Menu-updatedBy")
  menuActionsCreated    MenuAction[]    @relation("MenuAction-createdBy")
  menuActionsUpdated    MenuAction[]    @relation("MenuAction-updatedBy")
  UserDeviceCreated     UserDevice[]    @relation("UserDeviceCreatedBy")
  UserDeviceUpdated     UserDevice[]    @relation("UserDeviceupdatedBy")
}

model UserDevice {
  id            String    @id @default(cuid())
  deviceInnerId String
  userId        String
  deviceType    String
  os            String
  browser       String
  ip            String
  otp           Int?
  otpExpireAt   DateTime?
  isActive      Boolean   @default(false)

  createdAt       DateTime? @default(now())
  updatedAt       DateTime? @updatedAt
  updatedByUserId String?
  createdByUserId String?
  isDeleted       Boolean?  @default(false)
  meta            Json      @default("{}")

  createdBy User? @relation("UserDeviceCreatedBy", fields: [createdByUserId], references: [id])
  updatedBy User? @relation("UserDeviceupdatedBy", fields: [updatedByUserId], references: [id])

  user User @relation(fields: [userId], references: [id])
}

model Organization {
  id    String @id @unique @default(uuid())
  name  String @unique
  photo String

  createdAt       DateTime? @default(now())
  updatedAt       DateTime? @updatedAt
  updatedByUserId String?
  createdByUserId String?
  isDeleted       Boolean?  @default(false)
  meta            Json      @default("{}")

  createdBy User? @relation("OrganizationCreatedBy", fields: [createdByUserId], references: [id])
  updatedBy User? @relation("OrganizationupdatedBy", fields: [updatedByUserId], references: [id])
}

model Action {
  id     String @id @unique @default(uuid())
  name   String @unique
  path   String
  method String

  createdAt       DateTime? @default(now())
  updatedAt       DateTime? @updatedAt
  updatedByUserId String?
  createdByUserId String?
  isDeleted       Boolean?  @default(false)
  meta            Json      @default("{}")

  createdBy      User?           @relation("Action-CreatedBy", fields: [createdByUserId], references: [id])
  updatedBy      User?           @relation("Action-updatedBy", fields: [updatedByUserId], references: [id])
  roleActions    RoleAction[]
  userPrivileges UserPrivilege[]
  menuActions    MenuAction[]

  @@unique([path, method])
}

model Role {
  id   String @id @unique @default(uuid())
  name String @unique

  createdAt       DateTime? @default(now())
  updatedAt       DateTime? @updatedAt
  updatedByUserId String?
  createdByUserId String?
  isDeleted       Boolean?  @default(false)
  meta            Json      @default("{}")

  createdBy User? @relation("Role-CreatedBy", fields: [createdByUserId], references: [id])
  updatedBy User? @relation("Role-updatedBy", fields: [updatedByUserId], references: [id])

  users       User[]       @relation("user-role")
  roleActions RoleAction[]
}

model RoleAction {
  id       String @id @unique @default(uuid())
  roleId   String
  actionId String

  createdAt       DateTime? @default(now())
  updatedAt       DateTime? @updatedAt
  updatedByUserId String?
  createdByUserId String?
  isDeleted       Boolean?  @default(false)
  meta            Json      @default("{}")

  createdBy User? @relation("RoleAction-createdBy", fields: [createdByUserId], references: [id])
  updatedBy User? @relation("RoleAction-updatedBy", fields: [updatedByUserId], references: [id])

  role   Role   @relation(fields: [roleId], references: [id])
  action Action @relation(fields: [actionId], references: [id])
}

model UserPrivilege {
  id       String @id @unique @default(uuid())
  userId   String
  actionId String

  createdAt       DateTime? @default(now())
  updatedAt       DateTime? @updatedAt
  updatedByUserId String?
  createdByUserId String?
  isDeleted       Boolean?  @default(false)
  meta            Json      @default("{}")

  createdBy User? @relation("UserPrivilege-createdBy", fields: [createdByUserId], references: [id])
  updatedBy User? @relation("UserPrivilege-updatedBy", fields: [updatedByUserId], references: [id])

  user   User   @relation("User-Privilege", fields: [userId], references: [id])
  action Action @relation(fields: [actionId], references: [id])
}

model Menu {
  id        String  @id @unique @default(uuid())
  icon      String?
  name      String  @unique
  path      String?
  isDefault Boolean @default(false)

  createdAt       DateTime? @default(now())
  updatedAt       DateTime? @updatedAt
  updatedByUserId String?
  createdByUserId String?
  isDeleted       Boolean?  @default(false)
  meta            Json      @default("{}")

  createdBy   User?        @relation("Menu-createdBy", fields: [createdByUserId], references: [id])
  updatedBy   User?        @relation("Menu-updatedBy", fields: [updatedByUserId], references: [id])
  menuActions MenuAction[]
}

model MenuAction {
  id       String @id @unique @default(uuid())
  menuId   String
  actionId String

  createdAt       DateTime? @default(now())
  updatedAt       DateTime? @updatedAt
  updatedByUserId String?
  createdByUserId String?
  isDeleted       Boolean?  @default(false)
  meta            Json      @default("{}")

  createdBy User? @relation("MenuAction-createdBy", fields: [createdByUserId], references: [id])
  updatedBy User? @relation("MenuAction-updatedBy", fields: [updatedByUserId], references: [id])

  menu   Menu   @relation(fields: [menuId], references: [id])
  action Action @relation(fields: [actionId], references: [id])
}
